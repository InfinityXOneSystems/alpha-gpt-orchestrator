{
  \"openapi\": \"3.1.0\",
  \"info\": {
    \"title\": \"Infinity XOS Orchestrator\",
    \"version\": \"1.0.0\"
  },
  \"servers\": [
    {\"url\": \"http://localhost:8080\"}
  ],
  \"paths\": {
    \"/command\": {
      \"post\": {
        \"operationId\": \"sendCommand\",
        \"requestBody\": {
          \"required\": true,
          \"content\": {
            \"application/json\": {
              \"schema\": {
                \"type\": \"object\",
                \"properties\": {
                  \"intent\": {\"type\":\"string\"},
                  \"payload\": {\"type\":\"object\"}
                }
              }
            }
          }
        },
        \"responses\": {
          \"200\": {\"description\": \"Command accepted\"}
        }
      }
    }
  }
}
